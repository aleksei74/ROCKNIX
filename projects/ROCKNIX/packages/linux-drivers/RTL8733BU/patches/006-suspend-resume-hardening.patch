From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zetarancio <zetarancio@users.noreply.github.com>
Date: Mon, 17 Mar 2026 00:00:00 +0100
Subject: [PATCH] net: rtl8733bu: suspend/resume and USB RX hardening

1. Add dedicated rtw_reset_resume() handler — after a USB bus reset
   the firmware has lost all state.  The previous code aliased
   reset_resume to rtw_resume, which could take the lightweight
   WoWLAN resume path even though the firmware context is gone.
   Force full reinit by clearing wowlan flags before delegating.

2. Add 500 ms timeout to the bips_processing busy-wait in
   rtw_suspend_common() — if IPS enter/leave hangs (e.g. firmware
   not responding during a DVFS transition), the unbounded
   while-loop blocks the kernel suspend thread indefinitely.

3. Add 2 ms backoff delay before USB RX URB resubmit on transient
   errors (-EPROTO, -EILSEQ, -ETIME, -ECOMM, -EOVERFLOW) — without
   this the driver immediately retries in a tight loop, wasting CPU
   and potentially worsening USB bus contention during DVFS/suspend
   transitions on embedded SoCs (e.g. RK3566).  Both the
   CONFIG_USE_USB_BUFFER_ALLOC_RX and non-alloc code paths are
   patched.

Signed-off-by: Zetarancio <zetarancio@users.noreply.github.com>
---
 os_dep/linux/usb_intf.c       | 19 +++++++++++++++++++
 os_dep/linux/os_intfs.c       | 13 +++++++++++--
 os_dep/linux/usb_ops_linux.c  |  2 ++
 3 files changed, 32 insertions(+), 2 deletions(-)

--- a/os_dep/linux/usb_intf.c
+++ b/os_dep/linux/usb_intf.c
@@ -38,6 +38,10 @@
 static int rtw_suspend(struct usb_interface *intf, pm_message_t message);
 static int rtw_resume(struct usb_interface *intf);
 
+#if (LINUX_VERSION_CODE > KERNEL_VERSION(2, 6, 22))
+static int rtw_reset_resume(struct usb_interface *intf);
+#endif
+
 
 static int rtw_drv_init(struct usb_interface *pusb_intf, const struct usb_device_id *pdid);
 static void rtw_dev_remove(struct usb_interface *pusb_intf);
@@ -353,7 +357,7 @@
 	.usbdrv.suspend =  rtw_suspend,
 	.usbdrv.resume = rtw_resume,
 #if (LINUX_VERSION_CODE > KERNEL_VERSION(2, 6, 22))
-	.usbdrv.reset_resume   = rtw_resume,
+	.usbdrv.reset_resume   = rtw_reset_resume,
 #endif
 #ifdef CONFIG_USB_AUTOSUSPEND
 	.usbdrv.supports_autosuspend = 1,
@@ -1124,6 +1128,21 @@
 }
 
 
+
+#if (LINUX_VERSION_CODE > KERNEL_VERSION(2, 6, 22))
+static int rtw_reset_resume(struct usb_interface *pusb_intf)
+{
+	struct dvobj_priv *dvobj = usb_get_intfdata(pusb_intf);
+	struct pwrctrl_priv *pwrpriv = dvobj_to_pwrctl(dvobj);
+
+	RTW_INFO("%s: USB bus was reset, forcing full reinit\n", __func__);
+
+	pwrpriv->wowlan_mode = _FALSE;
+	pwrpriv->wowlan_ap_mode = _FALSE;
+
+	return rtw_resume(pusb_intf);
+}
+#endif
 #ifdef CONFIG_PLATFORM_RTD2880B
 extern void rtd2885_wlan_netlink_sendMsg(char *action_string, char *name);
 #endif
--- a/os_dep/linux/os_intfs.c
+++ b/os_dep/linux/os_intfs.c
@@ -5318,8 +5318,19 @@
 
 	pwrpriv->bInSuspend = _TRUE;
 
-	while (pwrpriv->bips_processing == _TRUE)
-		rtw_msleep_os(1);
+	{
+		systime ips_deadline = rtw_get_current_time();
+
+		while (pwrpriv->bips_processing == _TRUE) {
+			if (rtw_get_passing_time_ms(ips_deadline) > 500) {
+				RTW_WARN("%s: IPS processing timeout after 500 ms\n",
+					 __func__);
+				pwrpriv->bips_processing = _FALSE;
+				break;
+			}
+			rtw_msleep_os(1);
+		}
+	}
 
 #ifdef CONFIG_IOL_READ_EFUSE_MAP
 	if (!padapter->bup) {
--- a/os_dep/linux/usb_ops_linux.c
+++ b/os_dep/linux/usb_ops_linux.c
@@ -825,6 +825,7 @@
 				pHalData->srestpriv.Wifi_Error_Status = USB_READ_PORT_FAIL;
 			}
 			#endif
+			rtw_msleep_os(2);
 			rtw_read_port(padapter, precvpriv->ff_hwaddr, 0, (unsigned char *)precvbuf);
 			break;
 		case -EINPROGRESS:
@@ -1026,6 +1027,7 @@
 				pHalData->srestpriv.Wifi_Error_Status = USB_READ_PORT_FAIL;
 			}
 			#endif
+			rtw_msleep_os(2);
 			rtw_read_port(padapter, precvpriv->ff_hwaddr, 0, (unsigned char *)precvbuf);
 			break;
 		case -EINPROGRESS:
