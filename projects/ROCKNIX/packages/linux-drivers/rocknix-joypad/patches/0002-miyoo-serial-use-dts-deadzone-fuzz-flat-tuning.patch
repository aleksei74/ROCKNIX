+/*
+ * Read one complete 6-byte frame from the serial port, synchronising
+ * byte-by-byte so we automatically recover from any UART desync.
+ * Returns 0 on success (frame[] filled), negative errno on failure.
+ */
+static int miyoo_read_frame(struct joypad *joypad, unsigned char *frame)
+{
+	unsigned char byte;
+	int idx = 0;
+	int empty = 0;
+	int total = 0;
+	ssize_t n;
+	int i;
+
+	while (empty < 64 && total < 256) {
+		n = kernel_read(joypad->miyoo_filp, &byte, 1,
+				&joypad->miyoo_filp->f_pos);
+		if (n < 0)
+			return (int)n;
+		if (n == 0) {
+			usleep_range(500, 1000);
+			empty++;
+			continue;
+		}
+
+		empty = 0;
+		total++;
+
+		if (idx == 0) {
+			if (byte == MIYOO_MAGIC_START)
+				frame[idx++] = byte;
+			continue;
+		}
+
+		frame[idx++] = byte;
+
+		if (idx == MIYOO_FRAME_SIZE) {
+			if (frame[MIYOO_FRAME_SIZE - 1] == MIYOO_MAGIC_END)
+				return 0;
+
+			/* Desync: scan for a start byte in the tail */
+			idx = 0;
+			for (i = 1; i < MIYOO_FRAME_SIZE; i++) {
+				if (frame[i] == MIYOO_MAGIC_START) {
+					memmove(frame, &frame[i],
+						MIYOO_FRAME_SIZE - i);
+					idx = MIYOO_FRAME_SIZE - i;
+					break;
+				}
+			}
+		}
+	}
+
+	return -ETIMEDOUT;
 }
