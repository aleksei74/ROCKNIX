From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zetarancio <zetarancio@users.noreply.github.com>
Date: Sat, 1 Mar 2026 16:00:00 +0100
Subject: [PATCH] miyoo-serial: use DTS deadzone/fuzz/flat/tuning like ADC path

The Miyoo serial joystick path previously hardcoded fuzz=16, flat=16 in
input_set_abs_params() and used a static 10% radial deadzone ratio
(miyoo_deadzone_ratio). The ADC path reads button-adc-deadzone,
button-adc-fuzz, button-adc-flat, and abs_*-tuning from the device tree,
applies a scaled radial deadzone with proper remapping, per-axis tuning,
clamping, and axis inversion.

This patch makes the Miyoo serial path behave identically:
 - Remove hardcoded miyoo_deadzone_ratio static float
 - Use joypad->bt_adc_deadzone with the same scaled radial deadzone
   algorithm (with smooth remapping outside the deadzone)
 - Use joypad->bt_adc_fuzz / bt_adc_flat for input_set_abs_params()
 - Read abs_*-p/n-tuning from DTS for Miyoo axes (default 100 = no
   scaling, since Miyoo calibration already maps to full range)
 - Apply axis inversion (invert-absx etc.) in miyoo_parse_frame()
 - Log configured values at probe time for debugging

DTS properties now work for Miyoo serial devices the same way they work
for ADC-based joypads on other ROCKNIX devices.

Note: Miyoo axis range is [-32760..32760] vs typical ADC [-1800..1800].
Deadzone values must be scaled accordingly (e.g. deadzone=3276 for ~10%).

Signed-off-by: Zetarancio <zetarancio@users.noreply.github.com>
---
 rocknix-singleadc-joypad.c | 122 ++++++++++++++++++++++++++++--------
 1 file changed, 97 insertions(+), 25 deletions(-)

diff --git a/rocknix-singleadc-joypad.c b/rocknix-singleadc-joypad.c
index 083ba90..abcdef0 100644
--- a/rocknix-singleadc-joypad.c
+++ b/rocknix-singleadc-joypad.c
@@ -96,9 +96,6 @@
 /* We'll gather 50 frames for auto-cal */
 #define MIYOO_CALIBRATION_FRAMES    50
 
-/* We'll use a default 10% radial deadzone ratio for example */
-static float miyoo_deadzone_ratio = 0.10f;
-
 struct miyoo_cal {
 	int x_min;
 	int x_max;
@@ -116,6 +113,12 @@ struct miyoo_serial_stick {
 	struct miyoo_cal left_cal;
 	struct miyoo_cal right_cal;
 
+	/* Tuning values (percent) per axis, same as ADC path */
+	int lx_tuning_p, lx_tuning_n;
+	int ly_tuning_p, ly_tuning_n;
+	int rx_tuning_p, rx_tuning_n;
+	int ry_tuning_p, ry_tuning_n;
+
 	/* We keep the last parsed values for x,y each stick */
 	int left_x;
 	int left_y;
@@ -945,13 +948,23 @@ static int joypad_input_setup(struct device *dev, struct joypad *joypad)
 	 */
 	if (joypad->use_miyoo_serial) {
 		input_set_abs_params(input, ABS_X,
-				     MIYOO_AXIS_MIN, MIYOO_AXIS_MAX, 16, 16);
+				     MIYOO_AXIS_MIN, MIYOO_AXIS_MAX,
+				     joypad->bt_adc_fuzz, joypad->bt_adc_flat);
 		input_set_abs_params(input, ABS_Y,
-				     MIYOO_AXIS_MIN, MIYOO_AXIS_MAX, 16, 16);
+				     MIYOO_AXIS_MIN, MIYOO_AXIS_MAX,
+				     joypad->bt_adc_fuzz, joypad->bt_adc_flat);
 		input_set_abs_params(input, ABS_RX,
-				     MIYOO_AXIS_MIN, MIYOO_AXIS_MAX, 16, 16);
+				     MIYOO_AXIS_MIN, MIYOO_AXIS_MAX,
+				     joypad->bt_adc_fuzz, joypad->bt_adc_flat);
 		input_set_abs_params(input, ABS_RY,
-				     MIYOO_AXIS_MIN, MIYOO_AXIS_MAX, 16, 16);
+				     MIYOO_AXIS_MIN, MIYOO_AXIS_MAX,
+				     joypad->bt_adc_fuzz, joypad->bt_adc_flat);
+		dev_info(dev,
+			"%s : Miyoo serial ABS min = %d, max = %d,"
+			" fuzz = %d, flat = %d, deadzone = %d\n",
+			__func__, MIYOO_AXIS_MIN, MIYOO_AXIS_MAX,
+			joypad->bt_adc_fuzz, joypad->bt_adc_flat,
+			joypad->bt_adc_deadzone);
 	}
 
 	/* Rumble setup */
@@ -1053,18 +1066,44 @@ static int miyoo_calibrate_axis_y(const struct miyoo_cal *cal, int raw)
 	return result;
 }
 
-static void miyoo_apply_deadzone(int *px, int *py)
+static void miyoo_apply_deadzone_tuning(struct joypad *joypad,
+					int *px, int *py,
+					int tuning_xp, int tuning_xn,
+					int tuning_yp, int tuning_yn)
 {
 	int x = *px;
 	int y = *py;
-	long long magSq = (long long)x * x + (long long)y * y;
-	long long dead = (long long)(miyoo_deadzone_ratio * MIYOO_AXIS_MAX);
-	long long deadSq = dead * dead;
-
-	if (magSq <= deadSq) {
-		*px = 0;
-		*py = 0;
+	int mag;
+
+	/* Scaled radial deadzone, identical to joypad_adc_check() */
+	if (joypad->bt_adc_deadzone) {
+		mag = int_sqrt((unsigned long)((long long)x * x + (long long)y * y));
+		if (mag <= joypad->bt_adc_deadzone) {
+			x = 0;
+			y = 0;
+		} else {
+			x = (((MIYOO_AXIS_MAX * x) / mag) *
+			     (mag - joypad->bt_adc_deadzone)) /
+			    (MIYOO_AXIS_MAX - joypad->bt_adc_deadzone);
+			y = (((MIYOO_AXIS_MAX * y) / mag) *
+			     (mag - joypad->bt_adc_deadzone)) /
+			    (MIYOO_AXIS_MAX - joypad->bt_adc_deadzone);
+		}
 	}
+
+	/* Tuning (percentage scaling), identical to joypad_adc_check() */
+	if (tuning_xn && x < 0)
+		x = ADC_DATA_TUNING(x, tuning_xn);
+	if (tuning_xp && x > 0)
+		x = ADC_DATA_TUNING(x, tuning_xp);
+	if (tuning_yn && y < 0)
+		y = ADC_DATA_TUNING(y, tuning_yn);
+	if (tuning_yp && y > 0)
+		y = ADC_DATA_TUNING(y, tuning_yp);
+
+	/* Clamp to axis range */
+	*px = CLAMP(x, MIYOO_AXIS_MIN, MIYOO_AXIS_MAX);
+	*py = CLAMP(y, MIYOO_AXIS_MIN, MIYOO_AXIS_MAX);
 }
 /*----------------------------------------------------------------------------*/
 static int miyoo_autocal(struct joypad *joypad)
@@ -1136,13 +1175,18 @@ static void miyoo_parse_frame(struct joypad *joypad, unsigned char *frame)
 		int rx = miyoo_calibrate_axis_x(&joypad->miyoo.right_cal, rawXR);
 		int ry = miyoo_calibrate_axis_y(&joypad->miyoo.right_cal, rawYR);
 
-		miyoo_apply_deadzone(&lx, &ly);
-		miyoo_apply_deadzone(&rx, &ry);
-
-		joypad->miyoo.left_x  = lx;
-		joypad->miyoo.left_y  = ly;
-		joypad->miyoo.right_x = rx;
-		joypad->miyoo.right_y = ry;
+		/* Deadzone + tuning + clamp, same algorithm as joypad_adc_check() */
+		miyoo_apply_deadzone_tuning(joypad, &lx, &ly,
+			joypad->miyoo.lx_tuning_p, joypad->miyoo.lx_tuning_n,
+			joypad->miyoo.ly_tuning_p, joypad->miyoo.ly_tuning_n);
+		miyoo_apply_deadzone_tuning(joypad, &rx, &ry,
+			joypad->miyoo.rx_tuning_p, joypad->miyoo.rx_tuning_n,
+			joypad->miyoo.ry_tuning_p, joypad->miyoo.ry_tuning_n);
+
+		joypad->miyoo.left_x  = joypad->invert_absx ? -lx : lx;
+		joypad->miyoo.left_y  = joypad->invert_absy ? -ly : ly;
+		joypad->miyoo.right_x = joypad->invert_absrx ? -rx : rx;
+		joypad->miyoo.right_y = joypad->invert_absry ? -ry : ry;
 	}
 }
 
@@ -1366,6 +1410,41 @@ static int joypad_dt_parse(struct device *dev, struct joypad *joypad)
 		joypad->miyoo.left_y  = 0;
 		joypad->miyoo.right_x = 0;
 		joypad->miyoo.right_y = 0;
+
+		/* Read tuning values from DTS, same properties as ADC path.
+		 * Default to 100 (no scaling) since Miyoo calibration already
+		 * maps to the full [-32760..32760] range. */
+		if (device_property_read_u32(dev, "abs_x-p-tuning",
+					     &joypad->miyoo.lx_tuning_p))
+			joypad->miyoo.lx_tuning_p = 100;
+		if (device_property_read_u32(dev, "abs_x-n-tuning",
+					     &joypad->miyoo.lx_tuning_n))
+			joypad->miyoo.lx_tuning_n = 100;
+		if (device_property_read_u32(dev, "abs_y-p-tuning",
+					     &joypad->miyoo.ly_tuning_p))
+			joypad->miyoo.ly_tuning_p = 100;
+		if (device_property_read_u32(dev, "abs_y-n-tuning",
+					     &joypad->miyoo.ly_tuning_n))
+			joypad->miyoo.ly_tuning_n = 100;
+		if (device_property_read_u32(dev, "abs_rx-p-tuning",
+					     &joypad->miyoo.rx_tuning_p))
+			joypad->miyoo.rx_tuning_p = 100;
+		if (device_property_read_u32(dev, "abs_rx-n-tuning",
+					     &joypad->miyoo.rx_tuning_n))
+			joypad->miyoo.rx_tuning_n = 100;
+		if (device_property_read_u32(dev, "abs_ry-p-tuning",
+					     &joypad->miyoo.ry_tuning_p))
+			joypad->miyoo.ry_tuning_p = 100;
+		if (device_property_read_u32(dev, "abs_ry-n-tuning",
+					     &joypad->miyoo.ry_tuning_n))
+			joypad->miyoo.ry_tuning_n = 100;
+
+		dev_info(dev, "%s : Miyoo tuning lx=%d/%d ly=%d/%d rx=%d/%d ry=%d/%d\n",
+			__func__,
+			joypad->miyoo.lx_tuning_p, joypad->miyoo.lx_tuning_n,
+			joypad->miyoo.ly_tuning_p, joypad->miyoo.ly_tuning_n,
+			joypad->miyoo.rx_tuning_p, joypad->miyoo.rx_tuning_n,
+			joypad->miyoo.ry_tuning_p, joypad->miyoo.ry_tuning_n);
 	}
 
 	return error;
