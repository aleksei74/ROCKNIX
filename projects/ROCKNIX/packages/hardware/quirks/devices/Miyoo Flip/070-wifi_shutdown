# RTL8733BU: ensure WiFi/BT chip is fully powered down before kernel
# shutdown.  The out-of-tree 8733bu driver has no .shutdown callback on
# kernel >= 6.8, so the chip stays powered through the PMIC shutdown
# sequence.  If the chip holds the USB bus active, DEV_OFF / SLPPIN_DN_FUN
# may not complete cleanly, leaving the PMIC on and draining the battery.
#
# Install a systemd pre-shutdown unit that unloads the WiFi driver and
# cuts chip power (via rfkill → rtl8733bu_power GPIO) before the kernel
# reaches device_shutdown().

SHUTDOWN_SERVICE="/etc/systemd/system/wifi-shutdown-miyoo.service"

if [ ! -f "${SHUTDOWN_SERVICE}" ]; then
  cat <<'EOF' >"${SHUTDOWN_SERVICE}"
[Unit]
Description=Power down RTL8733BU WiFi/BT before shutdown
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target kexec.target
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c '\
  modprobe -r 8733bu 2>/dev/null; \
  modprobe -r btusb 2>/dev/null; \
  rfkill block wifi 2>/dev/null; \
  rfkill block bluetooth 2>/dev/null; \
  sleep 0.1'

[Install]
WantedBy=shutdown.target reboot.target halt.target kexec.target
EOF
  systemctl daemon-reload
  systemctl enable wifi-shutdown-miyoo.service 2>/dev/null
fi
