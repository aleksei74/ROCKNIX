#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2024 ROCKNIX (https://github.com/ROCKNIX)
# Miyoo Flip: 2 LEDs (green:power, red:charging), on/off only. Pattern from RK3588 2-LED ledcontrol. No brightness menu (010-led_control sets DEVICE_LED_BRIGHTNESS=false).

. /etc/profile.d/001-functions

LED_PATH="/sys/class/leds"
LED_STATUS=$(get_setting led.color)

led_state() {
  [ -d "${LED_PATH}/${1}" ] && echo "${2}" >"${LED_PATH}/${1}/brightness" 2>/dev/null
}

led_off() {
  led_state green:power 0
  led_state red:charging 0
}

led_green() {
  led_off
  led_state green:power 1
}

led_red() {
  led_off
  led_state red:charging 1
}

# No argument: read config and apply saved state (or default). Callers can run "ledcontrol" alone.
if [ -z "${1}" ]; then
  set -- "${LED_STATUS:-default}"
fi

case ${1} in
  green)
    led_green
    set_setting led.color ${1}
    ;;
  amber)
    led_red
    set_setting led.color red
    ;;
  red)
    led_red
    set_setting led.color ${1}
    ;;
  off)
    led_off
    set_setting led.color ${1}
    ;;
  discharging)
    if [ -n "${LED_STATUS}" ] && [ "${LED_STATUS}" != "off" ]; then
      ledcontrol ${LED_STATUS}
    else
      led_green
    fi
    ;;
  charging)
    if [ "${LED_STATUS}" != "off" ]; then
      led_red
    else
      led_off
    fi
    ;;
  default)
    del_setting led.color
    led_green
    ;;
  poweroff)
    led_off
    ;;
  brightness)
    if [ -n "${LED_STATUS}" ] && [ "${LED_STATUS}" != "off" ]; then
      ledcontrol ${LED_STATUS}
    else
      led_off
    fi
    ;;
  list)
    echo "default"
    echo "off"
    echo "green"
    echo "red"
    ;;
esac
