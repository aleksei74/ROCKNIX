#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2024 ROCKNIX (https://github.com/ROCKNIX)
# Miyoo Flip: 2 LEDs (green:power, amber:charging). Pattern from RK3588 2-LED ledcontrol.
# List: default, off, green, amber (no red). Charging shows amber; discharging restores user choice.

. /etc/profile.d/001-functions

LED_PATH="/sys/class/leds"
LED_STATUS=$(get_setting led.color)

# Brightness: default max, or from setting (min/mid/max -> 15/63/255)
GETBRIGHTNESS=$(get_setting led.brightness)
[ -n "${2}" ] && LEDBRIGHTNESS=${2} || LEDBRIGHTNESS=${GETBRIGHTNESS:-max}
[ "${LEDBRIGHTNESS}" != "${GETBRIGHTNESS}" ] && set_setting led.brightness "${LEDBRIGHTNESS}"
case ${LEDBRIGHTNESS} in
  max) B=255 ;; mid) B=63 ;; min) B=15 ;; *) B=255 ;;
esac

led_state() {
  [ -d "${LED_PATH}/${1}" ] && echo "${2}" >"${LED_PATH}/${1}/brightness" 2>/dev/null
}

led_off() {
  led_state green:power 0
  led_state amber:charging 0
}

led_green() {
  led_off
  led_state green:power ${B}
}

led_amber() {
  led_off
  led_state amber:charging ${B}
}

case ${1} in
  green)
    led_green
    set_setting led.color ${1}
    ;;
  amber)
    led_amber
    set_setting led.color ${1}
    ;;
  red)
    led_amber
    set_setting led.color amber
    ;;
  off)
    led_off
    set_setting led.color ${1}
    ;;
  discharging)
    if [ -n "${LED_STATUS}" ] && [ "${LED_STATUS}" != "off" ]; then
      ledcontrol ${LED_STATUS} ${LEDBRIGHTNESS}
    else
      led_green
    fi
    ;;
  charging)
    if [ "${LED_STATUS}" != "off" ]; then
      led_amber
    else
      led_off
    fi
    ;;
  default)
    del_setting led.color
    led_green
    ;;
  poweroff)
    led_off
    ;;
  brightness)
    if [ -n "${LED_STATUS}" ] && [ "${LED_STATUS}" != "off" ]; then
      ledcontrol ${LED_STATUS} ${LEDBRIGHTNESS}
    else
      led_off
    fi
    ;;
  list)
    echo "default"
    echo "off"
    echo "green"
    echo "amber"
    ;;
esac
