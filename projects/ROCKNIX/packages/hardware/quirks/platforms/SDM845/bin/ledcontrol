# The side and stick lights are four on/off blue LEDs

. /etc/profile.d/001-functions

set_leds() {
  if command -v odin-ledctl >/dev/null 2>&1; then
    if [ "${1}" = "0" ]; then
      odin-ledctl off >/dev/null
    else
      odin-ledctl restore >/dev/null
    fi
    return $?
  fi
  for n in 1 2 3 4; do
    echo ${1} >/sys/class/leds/blue:backlight-${n}/brightness
  done
}

case ${1} in
  off)
    set_leds 0 || exit $?
    set_setting led.color off
  ;;
  poweroff)
    set_leds 0
  ;;
  list)
    cat <<EOT
default
off
EOT
  ;;
  default)
    set_leds 1 || exit $?
    del_setting led.color
  ;;
  *)
    set_leds 1
  ;;
esac
