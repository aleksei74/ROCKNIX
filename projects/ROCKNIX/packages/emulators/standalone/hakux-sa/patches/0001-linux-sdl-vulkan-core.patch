+static void menu_release(void)
+{
+    if (g_ps.menu_map) T.vkUnmapMemory(g_hvk.dev, g_ps.menu_buf_mem);
+    if (g_ps.menu_view) T.vkDestroyImageView(g_hvk.dev, g_ps.menu_view, NULL);
+    if (g_ps.menu_img) T.vkDestroyImage(g_hvk.dev, g_ps.menu_img, NULL);
