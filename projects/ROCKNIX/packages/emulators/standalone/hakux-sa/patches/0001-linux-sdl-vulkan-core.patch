+
+static bool menu_resources(void)
+{
+    if (g_ps.menu_map && g_ps.menu_view) return true;
+    if (g_ps.menu_failed) return false;
+
+    const VkDeviceSize bytes = (VkDeviceSize)HAKUX_MENU_WIDTH * HAKUX_MENU_HEIGHT * 4u;
+    VkBufferCreateInfo bci = {
+        .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+        .size = bytes, .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT
+    };
+    if (T.vkCreateBuffer(g_hvk.dev, &bci, NULL, &g_ps.menu_buf) != VK_SUCCESS) goto fail;
+
+    VkMemoryRequirements mr;
+    T.vkGetBufferMemoryRequirements(g_hvk.dev, g_ps.menu_buf, &mr);
+    int mt = hle_vk_memtype(mr.memoryTypeBits,
+                            VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, 0);
+    if (mt < 0) goto fail;
+    VkMemoryAllocateInfo ai = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+        .allocationSize = mr.size, .memoryTypeIndex = (uint32_t)mt
+    };
+    if (T.vkAllocateMemory(g_hvk.dev, &ai, NULL, &g_ps.menu_buf_mem) != VK_SUCCESS ||
+        T.vkBindBufferMemory(g_hvk.dev, g_ps.menu_buf, g_ps.menu_buf_mem, 0) != VK_SUCCESS ||
+        T.vkMapMemory(g_hvk.dev, g_ps.menu_buf_mem, 0, bytes, 0,
+                      (void **)&g_ps.menu_map) != VK_SUCCESS) goto fail;
+
+    VkImageCreateInfo ici = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+        .imageType = VK_IMAGE_TYPE_2D, .format = VK_FORMAT_R8G8B8A8_UNORM,
+        .extent = { HAKUX_MENU_WIDTH, HAKUX_MENU_HEIGHT, 1 },
+        .mipLevels = 1, .arrayLayers = 1, .samples = VK_SAMPLE_COUNT_1_BIT,
+        .tiling = VK_IMAGE_TILING_OPTIMAL,
+        .usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+        .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED
+    };
+    if (T.vkCreateImage(g_hvk.dev, &ici, NULL, &g_ps.menu_img) != VK_SUCCESS) goto fail;
+    T.vkGetImageMemoryRequirements(g_hvk.dev, g_ps.menu_img, &mr);
+    mt = hle_vk_memtype(mr.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, 0);
+    if (mt < 0) goto fail;
+    ai = (VkMemoryAllocateInfo) {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+        .allocationSize = mr.size, .memoryTypeIndex = (uint32_t)mt
+    };
+    if (T.vkAllocateMemory(g_hvk.dev, &ai, NULL, &g_ps.menu_img_mem) != VK_SUCCESS ||
+        T.vkBindImageMemory(g_hvk.dev, g_ps.menu_img, g_ps.menu_img_mem, 0) != VK_SUCCESS) goto fail;
+
+    VkImageViewCreateInfo vi = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+        .image = g_ps.menu_img, .viewType = VK_IMAGE_VIEW_TYPE_2D,
+        .format = VK_FORMAT_R8G8B8A8_UNORM,
+        .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 }
+    };
+    if (T.vkCreateImageView(g_hvk.dev, &vi, NULL, &g_ps.menu_view) != VK_SUCCESS) goto fail;
+    return true;
+
+fail:
+    hle_log("hakuX-rocknix", "menu: unable to allocate Vulkan overlay");
+    menu_release();
+    g_ps.menu_failed = true;
+    return false;
+}
+
+static bool menu_upload(VkCommandBuffer cb)
+{
+    if (!hakux_menu_visible() || !g_ps.pipe[P_MENU] || !menu_resources()) return false;
+
+    const uint32_t revision = hakux_menu_revision();
+    if (g_ps.menu_uploaded && g_ps.menu_revision == revision) return true;
+    if (!wait_value(g_ps.submitted)) return g_ps.menu_uploaded;
+    if (!hakux_menu_render(g_ps.menu_map)) return g_ps.menu_uploaded;
+
+    VkMemoryBarrier2 host = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2,
+        .srcStageMask = VK_PIPELINE_STAGE_2_HOST_BIT,
+        .srcAccessMask = VK_ACCESS_2_HOST_WRITE_BIT,
+        .dstStageMask = VK_PIPELINE_STAGE_2_TRANSFER_BIT,
+        .dstAccessMask = VK_ACCESS_2_TRANSFER_READ_BIT
+    };
+    VkDependencyInfo info = {
+        .sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+        .memoryBarrierCount = 1, .pMemoryBarriers = &host
+    };
+    T.vkCmdPipelineBarrier2(cb, &info);
+    barrier(cb, g_ps.menu_img,
+            g_ps.menu_uploaded ? VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL : VK_IMAGE_LAYOUT_UNDEFINED,
+            VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+            g_ps.menu_uploaded ? VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT : VK_PIPELINE_STAGE_2_NONE,
+            g_ps.menu_uploaded ? VK_ACCESS_2_SHADER_SAMPLED_READ_BIT : 0,
+            VK_PIPELINE_STAGE_2_TRANSFER_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT);
+
+    VkBufferImageCopy region = {
+        .bufferOffset = 0,
+        .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .imageExtent = { HAKUX_MENU_WIDTH, HAKUX_MENU_HEIGHT, 1 }
+    };
+    T.vkCmdCopyBufferToImage(cb, g_ps.menu_buf, g_ps.menu_img,
+                             VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+    barrier(cb, g_ps.menu_img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+            VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+            VK_PIPELINE_STAGE_2_TRANSFER_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+            VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT);
+    g_ps.menu_uploaded = true;
+    g_ps.menu_revision = revision;
+    return true;
+}
+
+static void menu_draw(VkCommandBuffer cb, PsFrame *f, uint32_t w, uint32_t h)
+{
+    if (!hakux_menu_visible() || !g_ps.menu_uploaded || !g_ps.pipe[P_MENU]) return;
