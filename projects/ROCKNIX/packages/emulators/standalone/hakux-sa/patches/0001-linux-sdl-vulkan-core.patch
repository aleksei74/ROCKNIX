+    if (g_ps.menu_buf_mem) T.vkFreeMemory(g_hvk.dev, g_ps.menu_buf_mem, NULL);
+    g_ps.menu_map = NULL;
+    g_ps.menu_view = VK_NULL_HANDLE;
+    g_ps.menu_img = VK_NULL_HANDLE;
+    g_ps.menu_img_mem = VK_NULL_HANDLE;
+    g_ps.menu_buf = VK_NULL_HANDLE;
+    g_ps.menu_buf_mem = VK_NULL_HANDLE;
