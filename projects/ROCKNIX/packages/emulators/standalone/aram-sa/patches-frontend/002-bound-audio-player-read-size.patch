diff --git a/frontend/host_audio.go b/frontend/host_audio.go
index b35fe774..ac84d6ab 100644
--- a/frontend/host_audio.go
+++ b/frontend/host_audio.go
@@ -52,7 +52,10 @@
 	latency = normalizedAudioLatency(latency)
 	burst := properties.burst()
 	if burst == 0 {
-		return audioBufferPlan{queueTarget: latency, player: latency, pump: 4 * time.Millisecond}
+		// On Linux and other hosts without reliable device burst metadata,
+		// keep the requested queue reserve, but cap player read-ahead to
+		// 30 ms so one large host read cannot drain the queue at once.
+		return audioBufferPlan{queueTarget: latency, player: min(latency, 30*time.Millisecond), pump: 4 * time.Millisecond}
 	}
 	// Budget the Android queue and player read-ahead together instead of
 	// giving each the entire requested latency. Round each half up to a burst.
diff --git a/frontend/host_audio_test.go b/frontend/host_audio_test.go
