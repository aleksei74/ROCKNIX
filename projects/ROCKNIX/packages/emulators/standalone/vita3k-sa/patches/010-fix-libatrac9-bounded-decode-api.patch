+// LibAtrac9 in this pinned Vita3K submodule lacks the bounded entry point
+// expected by the Vita3K Plus codec. The config stores FrameBytes as an
+// 11-bit value plus one (1..2048). Copy exactly one frame into zero-padded
+// storage so the decoder's bit reader can safely peek a few trailing bytes
+// without accessing the caller's memory beyond the encoded frame.
+int Atrac9DecodeBounded(void* handle, const unsigned char *pAtrac9Buffer,
+    int availableBytes, short *pPcmBuffer, int *pNBytesUsed)
+{
+    enum { ATRAC9_MAX_FRAME_BYTES = 2048, ATRAC9_PEEK_PADDING = 4 };
+    Atrac9Handle *decoder = (Atrac9Handle*)handle;
+
+    if (!decoder || !decoder->Initialized || !pAtrac9Buffer ||
+        !pPcmBuffer || !pNBytesUsed)
+        return ERR_BAD_CONFIG_DATA;
+
+    *pNBytesUsed = 0;
+    const int frameBytes = decoder->Config.FrameBytes;
+    if (frameBytes <= 0 || frameBytes > ATRAC9_MAX_FRAME_BYTES ||
+        availableBytes < frameBytes)
+        return ERR_BAD_CONFIG_DATA;
+
+    unsigned char frame[ATRAC9_MAX_FRAME_BYTES + ATRAC9_PEEK_PADDING] = {0};
+    memcpy(frame, pAtrac9Buffer, (size_t)frameBytes);
+
+    const int status = Decode(decoder, frame, (unsigned char*)pPcmBuffer, pNBytesUsed);
+    if (status != ERR_SUCCESS)
+        return status;
+
+    if (*pNBytesUsed <= 0 || *pNBytesUsed > frameBytes) {
+        *pNBytesUsed = 0;
+        return ERR_BAD_CONFIG_DATA;
+    }
+    return ERR_SUCCESS;
+}
