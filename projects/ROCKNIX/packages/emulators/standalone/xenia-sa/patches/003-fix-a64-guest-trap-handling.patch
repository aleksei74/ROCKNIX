 void A64Emitter::DebugBreak() { brk(0xF000); }
 
-void A64Emitter::Trap(uint16_t trap_type) { brk(trap_type); }
+void A64Emitter::Trap(uint16_t trap_type) {
+  // Match the x64 backend's behavior without turning harmless guest debug
+  // print traps into unconditional host SIGTRAPs.
+  switch (trap_type) {
+    case 20:
+    case 26:
+    case 25:
+      break;
+    case 0:
+    case 22:
+      if (cvars::break_on_debugbreak) {
+        brk(trap_type);
+      }
+      break;
+    default:
+      XELOGW("Unknown guest trap type {}", trap_type);
+      break;
+  }
+}
 
