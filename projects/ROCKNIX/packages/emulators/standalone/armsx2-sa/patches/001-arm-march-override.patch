--- a/ARMSX2/app/src/main/cpp/cmake/BuildParameters.cmake
+++ b/ARMSX2/app/src/main/cpp/cmake/BuildParameters.cmake
@@ -137,7 +137,13 @@
 	else()
 		message(STATUS "Building for ARM64.")
 		# Require atomic rmw instructions
-		add_compile_options("-march=armv8.1-a")
+		# ROCKNIX: allow a per-target override of the ARM march. The default
+		# armv8.1-a emits LSE atomics, which ARMv8.0 cores (e.g. the
+		# Cortex-A72 on RK3576) lack and SIGILL on.
+		if(NOT DEFINED ARMSX2_ARM_MARCH)
+			set(ARMSX2_ARM_MARCH "armv8.1-a")
+		endif()
+		add_compile_options("-march=${ARMSX2_ARM_MARCH}")
 	endif()
 
