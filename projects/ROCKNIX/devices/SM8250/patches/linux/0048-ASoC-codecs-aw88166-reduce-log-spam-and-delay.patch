From 9f8a3c2b1e4d5f6a7b8c9d0e1f2a3b4c5d6e7f8a Mon Sep 17 00:00:00 2001
From: ROCKNIX <rocknix@rocknix.org>
Date: Sat, 25 Jul 2026 20:10:00 +0900
Subject: [PATCH] ASoC: codecs: aw88166: reduce log spam and delay on missing IIS clock

This driver creates excessive log spam and boot delay during initialization
due to the PLL not being ready when IIS clock is inactive. Change
intermediate dev_err() calls to dev_dbg() and avoid firmware reload on
start retries to reduce noise and speed up boot.
---
 sound/soc/codecs/aw88166.c | 25 +++++++++++--------------
 1 file changed, 11 insertions(+), 14 deletions(-)

diff --git a/sound/soc/codecs/aw88166.c b/sound/soc/codecs/aw88166.c
index 58571a50b5c0..a1b2c3d4e5f6 100644
--- a/sound/soc/codecs/aw88166.c
+++ b/sound/soc/codecs/aw88166.c
@@ -94,7 +94,7 @@ static int aw_dev_get_iis_status(struct aw_device *aw_dev)
 	if (ret)
 		return ret;
 	if ((reg_val & AW88166_BIT_PLL_CHECK) != AW88166_BIT_PLL_CHECK) {
-		dev_err(aw_dev->dev, "check pll lock fail, reg_val:0x%04x", reg_val);
+		dev_dbg(aw_dev->dev, "check pll lock fail, reg_val:0x%04x", reg_val);
 		return -EINVAL;
 	}
 
@@ -108,7 +108,7 @@ static int aw_dev_check_mode1_pll(struct aw_device *aw_dev)
 	for (i = 0; i < AW88166_DEV_SYSST_CHECK_MAX; i++) {
 		ret = aw_dev_get_iis_status(aw_dev);
 		if (ret) {
-			dev_err(aw_dev->dev, "mode1 iis signal check error");
+			dev_dbg(aw_dev->dev, "mode1 iis signal check error");
 			usleep_range(AW88166_2000_US, AW88166_2000_US + 10);
 		} else {
 			return 0;
@@ -143,7 +143,7 @@ static int aw_dev_check_mode2_pll(struct aw_device *aw_dev)
 	for (i = 0; i < AW88166_DEV_SYSST_CHECK_MAX; i++) {
 		ret = aw_dev_get_iis_status(aw_dev);
 		if (ret) {
-			dev_err(aw_dev->dev, "mode2 iis signal check error");
+			dev_dbg(aw_dev->dev, "mode2 iis signal check error");
 			usleep_range(AW88166_2000_US, AW88166_2000_US + 10);
 		} else {
 			break;
@@ -178,7 +178,7 @@ static int aw_dev_check_syspll(struct aw_device *aw_dev)
 		dev_dbg(aw_dev->dev, "mode1 check iis failed try switch to mode2 check");
 		ret = aw_dev_check_mode2_pll(aw_dev);
 		if (ret) {
-			dev_err(aw_dev->dev, "mode2 check iis failed");
+			dev_dbg(aw_dev->dev, "mode2 check iis failed");
 			return ret;
 		}
 	}
@@ -207,7 +207,7 @@ static int aw_dev_check_sysst(struct aw_device *aw_dev)
 		if ((reg_val & (~AW88166_BIT_SYSST_CHECK_MASK) & check_val) != check_val) {
-			dev_err(aw_dev->dev, "check sysst fail, cnt=%d, reg_val=0x%04x, check:0x%x",
+			dev_dbg(aw_dev->dev, "check sysst fail, cnt=%d, reg_val=0x%04x, check:0x%x",
 				i, reg_val, AW88166_BIT_SYSST_NOSWS_CHECK);
 			usleep_range(AW88166_2000_US, AW88166_2000_US + 10);
 		} else {
@@ -1169,19 +1169,16 @@ static void aw88166_start_pa(struct aw88166 *aw88166)
 {
 	int ret, i;
 
 	for (i = 0; i < AW88166_START_RETRIES; i++) {
 		ret = aw88166_dev_start(aw88166);
 		if (ret) {
-			dev_err(aw88166->aw_pa->dev, "aw88166 device start failed. retry = %d", i);
-			ret = aw88166_dev_fw_update(aw88166, AW88166_DSP_FW_UPDATE_ON, true);
-			if (ret) {
-				dev_err(aw88166->aw_pa->dev, "fw update failed");
-				continue;
-			}
+			dev_dbg(aw88166->aw_pa->dev, "aw88166 device start failed. retry = %d", i);
+			continue;
 		} else {
 			dev_dbg(aw88166->aw_pa->dev, "start success\n");
 			break;
 		}
 	}
+	if (ret != 0)
+		dev_dbg(aw88166->aw_pa->dev, "start failure (%d)\n", ret);
 }
