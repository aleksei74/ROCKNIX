Subject: [PATCH] power: supply: qcom_smbx: enable HVDCP for AYN Odin

The AYN Odin supports Quick Charge. Enable the complete HVDCP negotiation
path for this device while keeping the generic SMBX default unchanged.

---
 drivers/power/supply/qcom_smbx.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/drivers/power/supply/qcom_smbx.c b/drivers/power/supply/qcom_smbx.c
--- a/drivers/power/supply/qcom_smbx.c
+++ b/drivers/power/supply/qcom_smbx.c
@@ -817,3 +817,6 @@ static const struct smb_init_register smb_init_seq[] = {
 	/* Enable charging */
-	{ .addr = USBIN_OPTIONS_1_CFG, .mask = HVDCP_EN_BIT, .val = 0 },
+	/* Enable authentication and autonomous HVDCP voltage negotiation. */
+	{ .addr = USBIN_OPTIONS_1_CFG,
+	  .mask = BIT(6) | BIT(5) | HVDCP_EN_BIT,
+	  .val = BIT(6) | BIT(5) | HVDCP_EN_BIT },
 	{ .addr = CHARGING_ENABLE_CMD,
