From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zetarancio <zetarancio@users.noreply.github.com>
Date: Tue, 25 Feb 2025 12:00:00 +0000
Subject: [PATCH] soc: rockchip: add rk3568 suspend mode configuration driver

Add a driver that configures ARM Trusted Firmware (BL31) deep-sleep
flags on RK3568/RK3566 SoCs via SIP_SUSPEND_MODE SMC calls.

Without this driver BL31 uses its compiled-in defaults, which on most
firmware images do not enable the deepest sleep modes (oscillator off,
PMIC low-power, center power domain off, etc.).  The driver reads
sleep-mode and wakeup-source bitmasks from the device tree and passes
them to BL31 at probe time and again before each suspend.

Log non-zero SMC returns from firmware (mode, wakeup, and debug paths)
without treating specific error codes as stable across ATF revisions.

Also add SIP_SUSPEND_MODE sub-command definitions to rockchip_sip.h
and clean up the dt-bindings header to follow upstream conventions
(inline shift expressions instead of redefining BIT()).

Signed-off-by: Zetarancio <zetarancio@users.noreply.github.com>
---
 drivers/soc/rockchip/Kconfig                   |   9 +
 drivers/soc/rockchip/Makefile                    |   1 +
 drivers/soc/rockchip/rk3568_suspend_config.c    | 133 +++++++++++++++++++++++++++++
 include/dt-bindings/suspend/rockchip-rk3568.h    |  43 +++++++++
 include/soc/rockchip/rockchip_sip.h              |   6 +
 5 files changed, 192 insertions(+)
 create mode 100644 drivers/soc/rockchip/rk3568_suspend_config.c
 create mode 100644 include/dt-bindings/suspend/rockchip-rk3568.h

diff --git a/drivers/soc/rockchip/Kconfig b/drivers/soc/rockchip/Kconfig
--- a/drivers/soc/rockchip/Kconfig	2026-04-10 00:53:53.962843518 +0200
+++ b/drivers/soc/rockchip/Kconfig	2026-04-10 00:53:53.966113911 +0200
@@ -30,4 +30,13 @@
 	  on this platform. That will create all the power capping capable
 	  devices.
 
+
+config RK3568_SUSPEND_MODE
+	bool "RK3568 suspend mode configuration"
+	depends on HAVE_ARM_SMCCC && SUSPEND && ARCH_ROCKCHIP
+	help
+	  Configure deep-sleep flags for BL31 (ARM Trusted Firmware)
+	  on Rockchip RK3568/RK3566 SoCs via SIP SMC calls.
+	  Required for lowest-power suspend (vdd_logic off, oscillator off).
+
 endif
diff --git a/drivers/soc/rockchip/Makefile b/drivers/soc/rockchip/Makefile
--- a/drivers/soc/rockchip/Makefile	2026-04-10 00:53:53.963757946 +0200
+++ b/drivers/soc/rockchip/Makefile	2026-04-10 00:53:53.968113914 +0200
@@ -5,3 +5,4 @@
 obj-$(CONFIG_ROCKCHIP_GRF) += grf.o
 obj-$(CONFIG_ROCKCHIP_IODOMAIN) += io-domain.o
 obj-$(CONFIG_ROCKCHIP_DTPM) += dtpm.o
+obj-$(CONFIG_RK3568_SUSPEND_MODE) += rk3568_suspend_config.o
diff --git a/drivers/soc/rockchip/rk3568_suspend_config.c b/drivers/soc/rockchip/rk3568_suspend_config.c
--- a/drivers/soc/rockchip/rk3568_suspend_config.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/soc/rockchip/rk3568_suspend_config.c	2026-04-10 00:53:53.972113921 +0200
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * RK3568/RK3566 suspend mode configuration driver
+ *
+ * Configures BL31 (ARM Trusted Firmware) deep-sleep flags via
+ * SIP_SUSPEND_MODE SMC calls.  Without this driver BL31 uses
+ * compiled-in defaults which may not enable the deepest sleep modes.
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include <soc/rockchip/rockchip_sip.h>
+
+struct rk3568_suspend {
+	u32	mode_config;
+	u32	wakeup_config;
+	bool	have_debug;
+	u32	debug_en;
+};
+
+/*
+ * Issue a SIP_SUSPEND_MODE SMC sub-command.  BL31 returns 0 on success.
+ * Non-zero values are logged; firmware revisions do not use a single
+ * stable error space across parts.
+ */
+static int rk3568_sip_suspend_mode(struct device *dev, u32 ctrl, u32 cfg1, u32 cfg2)
+{
+	struct arm_smccc_res res;
+	long err;
+
+	arm_smccc_smc(ROCKCHIP_SIP_SUSPEND_MODE, ctrl, cfg1, cfg2,
+		      0, 0, 0, 0, &res);
+	err = (long)res.a0;
+	if (err)
+		dev_warn(dev, "SIP_SUSPEND_MODE ctrl=0x%x failed, ret=%ld\n",
+			 ctrl, err);
+	return err ? -EIO : 0;
+}
+
+static int rk3568_suspend_apply(struct device *dev, struct rk3568_suspend *s)
+{
+	int ret = 0, err;
+
+	if (s->mode_config) {
+		err = rk3568_sip_suspend_mode(dev, ROCKCHIP_SIP_SUSPEND_MODE_CONFIG,
+					       s->mode_config, 0);
+		if (err && !ret)
+			ret = err;
+	}
+	if (s->wakeup_config) {
+		err = rk3568_sip_suspend_mode(dev, ROCKCHIP_SIP_SUSPEND_WKUP_CONFIG,
+					       s->wakeup_config, 0);
+		if (err && !ret)
+			ret = err;
+	}
+	if (s->have_debug) {
+		err = rk3568_sip_suspend_mode(dev, ROCKCHIP_SIP_SUSPEND_DEBUG_EN,
+					       s->debug_en, 0);
+		if (err && !ret)
+			ret = err;
+	}
+
+	return ret;
+}
+
+static int rk3568_suspend_prepare(struct device *dev)
+{
+	struct rk3568_suspend *s = dev_get_drvdata(dev);
+
+	rk3568_suspend_apply(dev, s);
+	return 0;
+}
+
+static const struct dev_pm_ops rk3568_suspend_pm_ops = {
+	.prepare = rk3568_suspend_prepare,
+};
+
+static int rk3568_suspend_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *node = dev->of_node;
+	struct rk3568_suspend *s;
+	int ret;
+
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+
+	if (of_property_read_u32(node, "rockchip,sleep-mode-config",
+				 &s->mode_config))
+		dev_warn(dev, "sleep-mode-config not set\n");
+
+	if (of_property_read_u32(node, "rockchip,wakeup-config",
+				 &s->wakeup_config))
+		dev_warn(dev, "wakeup-config not set\n");
+
+	if (of_property_read_u32(node, "rockchip,sleep-debug-en", &s->debug_en))
+		s->have_debug = false;
+	else
+		s->have_debug = true;
+
+	platform_set_drvdata(pdev, s);
+
+	ret = rk3568_suspend_apply(dev, s);
+	if (ret)
+		dev_warn(dev, "suspend SMC configuration incomplete (ret=%d)\n", ret);
+	dev_info(dev, "sleep-mode-config=0x%x wakeup-config=0x%x\n",
+		 s->mode_config, s->wakeup_config);
+
+	return 0;
+}
+
+static const struct of_device_id rk3568_suspend_match[] = {
+	{ .compatible = "rockchip,rk3568-suspend" },
+	{ },
+};
+MODULE_DEVICE_TABLE(of, rk3568_suspend_match);
+
+static struct platform_driver rk3568_suspend_driver = {
+	.probe = rk3568_suspend_probe,
+	.driver = {
+		.name = "rk3568-suspend-config",
+		.of_match_table = rk3568_suspend_match,
+		.pm = &rk3568_suspend_pm_ops,
+	},
+};
+module_platform_driver(rk3568_suspend_driver);
+
+MODULE_DESCRIPTION("RK3568/RK3566 suspend mode configuration");
+MODULE_LICENSE("GPL");
diff --git a/include/dt-bindings/suspend/rockchip-rk3568.h b/include/dt-bindings/suspend/rockchip-rk3568.h
--- a/include/dt-bindings/suspend/rockchip-rk3568.h	1970-01-01 01:00:00.000000000 +0100
+++ b/include/dt-bindings/suspend/rockchip-rk3568.h	2026-04-10 00:53:53.974128819 +0200
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: (GPL-2.0+ OR MIT) */
+/*
+ * Header providing constants for Rockchip RK3568/RK3566 suspend bindings.
+ *
+ * Copyright (C) 2021, Rockchip Electronics Co., Ltd.
+ */
+
+#ifndef __DT_BINDINGS_SUSPEND_ROCKCHIP_RK3568_H__
+#define __DT_BINDINGS_SUSPEND_ROCKCHIP_RK3568_H__
+
+/* Sleep mode flags (rockchip,sleep-mode-config) */
+#define RKPM_SLP_WFI			(1 << 0)
+#define RKPM_SLP_ARMOFF			(1 << 1)
+#define RKPM_SLP_CENTER_OFF		(1 << 2)
+#define RKPM_SLP_ARMOFF_LOGOFF		(1 << 3)
+#define RKPM_SLP_FROM_UBOOT		(1 << 4)
+#define RKPM_SLP_PMIC_LP		(1 << 5)
+#define RKPM_SLP_HW_PLLS_OFF		(1 << 6)
+#define RKPM_SLP_PMUALIVE_32K		(1 << 7)
+#define RKPM_SLP_OSC_DIS		(1 << 8)
+#define RKPM_SLP_32K_EXT		(1 << 9)
+#define RKPM_SLP_32K_PVTM		(1 << 10)
+
+/* Wakeup source flags (rockchip,wakeup-config) */
+#define RKPM_CPU0_WKUP_EN		(1 << 0)
+#define RKPM_CPU1_WKUP_EN		(1 << 1)
+#define RKPM_CPU2_WKUP_EN		(1 << 2)
+#define RKPM_CPU3_WKUP_EN		(1 << 3)
+#define RKPM_GPIO_WKUP_EN		(1 << 4)
+#define RKPM_UART0_WKUP_EN		(1 << 5)
+#define RKPM_SDMMC0_WKUP_EN		(1 << 6)
+#define RKPM_SDMMC1_WKUP_EN		(1 << 7)
+#define RKPM_SDMMC2_WKUP_EN		(1 << 8)
+#define RKPM_USB_WKUP_EN		(1 << 9)
+#define RKPM_PCIE_WKUP_EN		(1 << 10)
+#define RKPM_VAD_WKUP_EN		(1 << 11)
+#define RKPM_TIMER_WKUP_EN		(1 << 12)
+#define RKPM_PWM0_WKUP_EN		(1 << 13)
+#define RKPM_TIMEOUT_WKUP_EN		(1 << 14)
+#define RKPM_SFT_WKUP_EN		(1 << 15)
+#define RKPM_USB_LINESTATE_WKUP_EN	(1 << 16)
+
+#endif
diff --git a/include/soc/rockchip/rockchip_sip.h b/include/soc/rockchip/rockchip_sip.h
--- a/include/soc/rockchip/rockchip_sip.h	2026-04-10 00:53:53.949113881 +0200
+++ b/include/soc/rockchip/rockchip_sip.h	2026-04-10 00:53:53.969113916 +0200
@@ -9,6 +9,12 @@
 #define ROCKCHIP_SIP_SUSPEND_MODE		0x82000003
 #define ROCKCHIP_SLEEP_PD_CONFIG		0xff
 
+/* SIP_SUSPEND_MODE sub-commands */
+#define ROCKCHIP_SIP_SUSPEND_MODE_CONFIG	0x01
+#define ROCKCHIP_SIP_SUSPEND_WKUP_CONFIG	0x02
+#define ROCKCHIP_SIP_SUSPEND_DEBUG_EN		0x05
+
+
 #define ROCKCHIP_SIP_DRAM_FREQ			0x82000008
 #define ROCKCHIP_SIP_CONFIG_DRAM_INIT		0x00
 #define ROCKCHIP_SIP_CONFIG_DRAM_SET_RATE	0x01
