From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zetarancio <zetarancio@users.noreply.github.com>
Date: Tue, 25 Feb 2025 12:00:00 +0000
Subject: [PATCH] dt-bindings: soc: rockchip: add rk3568 suspend configuration

Document the devicetree binding for the RK3568/RK3566 suspend mode
configuration node.  This node passes deep-sleep flags (sleep mode,
wakeup sources) to the ARM Trusted Firmware via SIP SMC calls.

Signed-off-by: Zetarancio <zetarancio@users.noreply.github.com>
---
 .../soc/rockchip/rockchip,rk3568-suspend.yaml | 75 ++++++++++++++++
 1 file changed, 75 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/rockchip/rockchip,rk3568-suspend.yaml

diff --git a/Documentation/devicetree/bindings/soc/rockchip/rockchip,rk3568-suspend.yaml b/Documentation/devicetree/bindings/soc/rockchip/rockchip,rk3568-suspend.yaml
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/rockchip/rockchip,rk3568-suspend.yaml
@@ -0,0 +1,75 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+# %YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/rockchip/rockchip,rk3568-suspend.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Rockchip RK3568/RK3566 Suspend Mode Configuration
+
+maintainers:
+  - Heiko Stuebner <heiko@sntech.de>
+
+description: |
+  Configures ARM Trusted Firmware (BL31) deep-sleep parameters on
+  RK3568/RK3566 SoCs.  The driver reads sleep-mode and wakeup-source
+  bitmasks from the device tree and passes them to BL31 via
+  SIP_SUSPEND_MODE (0x82000003) SMC calls at probe and before each
+  suspend.
+
+  Without this node (or with status = "disabled") BL31 uses its
+  compiled-in defaults, which may not enable the deepest sleep modes.
+
+  This binding covers only the SIP_SUSPEND_MODE path used for deep-sleep
+  flags; it is intentionally smaller than vendor "rockchip-pm-config"
+  nodes that also drive regulator and pin settings.
+
+  Flag definitions are in include/dt-bindings/suspend/rockchip-rk3568.h.
+
+properties:
+  compatible:
+    enum:
+      - rockchip,rk3568-suspend
+
+  status: true
+
+  rockchip,sleep-mode-config:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Bitmask of RKPM_SLP_* flags controlling sleep depth (ARM off,
+      center PD off, PLLs off, oscillator off, PMIC low-power, etc.).
+
+  rockchip,wakeup-config:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Bitmask of RKPM_*_WKUP_EN flags selecting wakeup sources
+      (GPIO, UART, USB, timer, etc.).
+
+  rockchip,sleep-debug-en:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Set to 1 to enable ATF suspend/resume debug output on the
+      serial console.  Requires kernel no_console_suspend boot
+      parameter.
+    default: 0
+
+required:
+  - compatible
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/suspend/rockchip-rk3568.h>
+
+    rk3568-suspend {
+        compatible = "rockchip,rk3568-suspend";
+        rockchip,sleep-mode-config = <(
+            RKPM_SLP_CENTER_OFF |
+            RKPM_SLP_ARMOFF_LOGOFF |
+            RKPM_SLP_PMIC_LP |
+            RKPM_SLP_HW_PLLS_OFF |
+            RKPM_SLP_PMUALIVE_32K |
+            RKPM_SLP_OSC_DIS |
+            RKPM_SLP_32K_PVTM)>;
+        rockchip,wakeup-config = <RKPM_GPIO_WKUP_EN>;
+    };
-- 
2.34.1

