From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zetarancio <zetarancio@users.noreply.github.com>
Date: Sun, 15 Mar 2026 00:00:00 +0000
Subject: [PATCH] mfd: rk8xx: add BSP-style PMIC pinctrl switching and
 power-state hardening for RK817/RK809

Port the PMIC sleep-pin pinctrl switching and power-state management
from vendor BSP rk808.c to the mainline rk8xx-core.c
driver.

The RK817/RK809 PMIC uses GPIO0_PA2 (SLPPIN) for two purposes:
  - Suspend: the SoC PMU drives the pin (PMU_SLEEP mux) to signal
    the PMIC to enter low-power mode.
  - Power-off: BL31 drives the pin as GPIO to assert SLPPIN after
    the kernel writes SLPPIN_DN_FUN.

The mainline driver only does register writes (SLPPIN_SLP_FUN,
SLPPIN_DN_FUN, SLPPIN_NULL_FUN) but never switches the SoC-side
pin mux, nor follows the BSP's safe transition sequence.  If the
pin is stuck in PMU_SLEEP mux at power-off time, BL31 cannot
drive it and the PMIC stays on, draining the battery.

Changes ported from BSP:

1) Add optional pinctrl lookup for "pmic-sleep", "pmic-power-off"
   and "pmic-reset" states on the PMIC DT node (BSP convention).

2) Suspend: replace the single SLPPIN_SLP_FUN write with the BSP
   sequence: SLPPIN_NULL_FUN -> SLPPOL_H -> SYS_STS sync read ->
   2 ms delay -> select "pmic-sleep" pinctrl.

3) Resume: replace the single SLPPIN_NULL_FUN write with the BSP
   sequence: select "pmic-reset" (or default) pinctrl ->
   SLPPIN_NULL_FUN -> SLPPOL_L -> SYS_STS sync read -> 2 ms delay.

4) Shutdown: mask all PMIC interrupts (INT_STS_MSK_REG0-2 and
   RTC alarm), use the BSP's full SLPPIN sequence (clear function,
   set SLPPOL_H, select power-off pinctrl), then assert
   SLPPIN_DN_FUN with a 2 ms I2C sync delay.

5) Probe-time init (BSP parity): configure DCDC3 feedback resistor
   to external (RK817_BUCK3_FB_RES_EXT) and initialize SYS_CFG(3)
   to SLPPIN_NULL_FUN + RST_FUNC_DEV so the PMIC starts from a
   known safe state regardless of what U-Boot left behind.

Boards that do not define these pinctrl states are unaffected;
all state lookups are optional and NULL-checked.

Signed-off-by: Zetarancio <zetarancio@users.noreply.github.com>
---
 drivers/mfd/rk8xx-core.c  | 126 ++++++++++++++++++++++++++++++++++---
 include/linux/mfd/rk808.h |   8 +++
 2 files changed, 124 insertions(+), 10 deletions(-)

diff --git a/drivers/mfd/rk8xx-core.c b/drivers/mfd/rk8xx-core.c
--- a/drivers/mfd/rk8xx-core.c
+++ b/drivers/mfd/rk8xx-core.c
@@ -16,7 +16,9 @@
 #include <linux/mfd/core.h>
 #include <linux/module.h>
 #include <linux/property.h>
+#include <linux/delay.h>
 #include <linux/regmap.h>
+#include <linux/pinctrl/consumer.h>
 #include <linux/reboot.h>
 
 struct rk808_reg_data {
@@ -603,6 +605,58 @@
 	.init_ack_masked = true,
 };
 
+static void rk817_pinctrl_init(struct device *dev, struct rk808 *rk808)
+{
+	struct rk8xx_pin_info *pins;
+	struct pinctrl *p;
+
+	p = devm_pinctrl_get(dev);
+	if (IS_ERR(p))
+		return;
+
+	pins = devm_kzalloc(dev, sizeof(*pins), GFP_KERNEL);
+	if (!pins)
+		return;
+
+	pins->p = p;
+
+	pins->sleep = pinctrl_lookup_state(p, "pmic-sleep");
+	if (IS_ERR(pins->sleep)) {
+		pins->sleep = NULL;
+		dev_dbg(dev, "no pmic-sleep pinctrl state\n");
+	}
+
+	pins->power_off = pinctrl_lookup_state(p, "pmic-power-off");
+	if (IS_ERR(pins->power_off)) {
+		pins->power_off = NULL;
+		dev_dbg(dev, "no pmic-power-off pinctrl state\n");
+	}
+
+	pins->reset = pinctrl_lookup_state(p, "pmic-reset");
+	if (IS_ERR(pins->reset)) {
+		pins->reset = NULL;
+		dev_dbg(dev, "no pmic-reset pinctrl state\n");
+	}
+
+	if (pins->sleep || pins->power_off || pins->reset) {
+		rk808->pins = pins;
+		dev_info(dev, "PMIC pinctrl: sleep=%s power-off=%s reset=%s\n",
+			 pins->sleep ? "yes" : "no",
+			 pins->power_off ? "yes" : "no",
+			 pins->reset ? "yes" : "no");
+	}
+
+	/* BSP probe-time init: DCDC3 feedback to external resistor */
+	regmap_update_bits(rk808->regmap, RK817_POWER_CONFIG,
+			   RK817_BUCK3_FB_RES_MSK, RK817_BUCK3_FB_RES_EXT);
+
+	/* BSP probe-time init: SLPPIN = NULL, reset func = reset dev.
+	 * Ensures known safe state regardless of what U-Boot left. */
+	regmap_update_bits(rk808->regmap, RK817_SYS_CFG(3),
+			   RK817_SLPPIN_FUNC_MSK | RK817_RST_FUNC_MSK,
+			   SLPPIN_NULL_FUN | RK817_RST_FUNC_DEV);
+}
+
 static int rk808_power_off(struct sys_off_data *data)
 {
 	struct rk808 *rk808 = data->cb_data;
@@ -679,10 +733,35 @@
 		break;
 	case RK809_ID:
 	case RK817_ID:
+		/* Mask all PMIC interrupts before power-off */
+		regmap_update_bits(rk808->regmap,
+				   RK817_INT_STS_MSK_REG0, 0xff, 0xff);
+		regmap_update_bits(rk808->regmap,
+				   RK817_INT_STS_MSK_REG1, 0xff, 0xff);
+		regmap_update_bits(rk808->regmap,
+				   RK817_INT_STS_MSK_REG2, 0xff, 0xff);
+		regmap_update_bits(rk808->regmap,
+				   RK817_RTC_INT_REG, (0x3 << 2), 0);
+
+		if (rk808->pins && rk808->pins->power_off) {
+			regmap_update_bits(rk808->regmap,
+					   RK817_SYS_CFG(3),
+					   RK817_SLPPIN_FUNC_MSK,
+					   SLPPIN_NULL_FUN);
+			regmap_update_bits(rk808->regmap,
+					   RK817_SYS_CFG(3),
+					   RK817_SLPPOL_MSK,
+					   RK817_SLPPOL_H);
+			pinctrl_select_state(rk808->pins->p,
+					     rk808->pins->power_off);
+		}
+
 		ret = regmap_update_bits(rk808->regmap,
 					 RK817_SYS_CFG(3),
 					 RK817_SLPPIN_FUNC_MSK,
 					 SLPPIN_DN_FUN);
+		/* PMIC needs the SCL clock to synchronize the register */
+		mdelay(2);
 		break;
 	default:
 		return;
@@ -713,6 +792,15 @@
 	rk808->regmap = regmap;
 	dev_set_drvdata(dev, rk808);
 
+	switch (variant) {
+	case RK809_ID:
+	case RK817_ID:
+		rk817_pinctrl_init(dev, rk808);
+		break;
+	default:
+		break;
+	}
+
 	switch (rk808->variant) {
 	case RK805_ID:
 		rk808->regmap_irq_chip = &rk805_irq_chip;
@@ -853,12 +941,25 @@
 					 SLEEP_FUN);
 		break;
 	case RK809_ID:
-	case RK817_ID:
-		ret = regmap_update_bits(rk808->regmap,
-					 RK817_SYS_CFG(3),
-					 RK817_SLPPIN_FUNC_MSK,
-					 SLPPIN_SLP_FUN);
+	case RK817_ID: {
+		unsigned int tmp;
+
+		regmap_update_bits(rk808->regmap,
+				   RK817_SYS_CFG(3),
+				   RK817_SLPPIN_FUNC_MSK,
+				   SLPPIN_NULL_FUN);
+		regmap_update_bits(rk808->regmap,
+				   RK817_SYS_CFG(3),
+				   RK817_SLPPOL_MSK,
+				   RK817_SLPPOL_H);
+		regmap_read(rk808->regmap, RK817_SYS_STS, &tmp);
+		mdelay(2);
+
+		if (rk808->pins && rk808->pins->sleep)
+			pinctrl_select_state(rk808->pins->p,
+					     rk808->pins->sleep);
 		break;
+	}
 	default:
 		break;
 	}
@@ -874,12 +975,27 @@
 
 	switch (rk808->variant) {
 	case RK809_ID:
-	case RK817_ID:
-		ret = regmap_update_bits(rk808->regmap,
-					 RK817_SYS_CFG(3),
-					 RK817_SLPPIN_FUNC_MSK,
-					 SLPPIN_NULL_FUN);
+	case RK817_ID: {
+		unsigned int tmp;
+
+		if (rk808->pins && rk808->pins->reset)
+			pinctrl_select_state(rk808->pins->p,
+					     rk808->pins->reset);
+		else if (rk808->pins && rk808->pins->p)
+			pinctrl_select_default_state(dev);
+
+		regmap_update_bits(rk808->regmap,
+				   RK817_SYS_CFG(3),
+				   RK817_SLPPIN_FUNC_MSK,
+				   SLPPIN_NULL_FUN);
+		regmap_update_bits(rk808->regmap,
+				   RK817_SYS_CFG(3),
+				   RK817_SLPPOL_MSK,
+				   RK817_SLPPOL_L);
+		regmap_read(rk808->regmap, RK817_SYS_STS, &tmp);
+		mdelay(2);
 		break;
+	}
 	default:
 		break;
 	}
diff --git a/include/linux/mfd/rk808.h b/include/linux/mfd/rk808.h
--- a/include/linux/mfd/rk808.h
+++ b/include/linux/mfd/rk808.h
@@ -1341,6 +1341,13 @@
 	RK818_ID = 0x8180,
 };
 
+struct rk8xx_pin_info {
+	struct pinctrl		*p;
+	struct pinctrl_state	*sleep;
+	struct pinctrl_state	*power_off;
+	struct pinctrl_state	*reset;
+};
+
 struct rk808 {
 	struct device			*dev;
 	struct regmap_irq_chip_data	*irq_data;
@@ -1348,6 +1355,7 @@
 	long				variant;
 	const struct regmap_config	*regmap_cfg;
 	const struct regmap_irq_chip	*regmap_irq_chip;
+	struct rk8xx_pin_info		*pins;
 };
 
 void rk8xx_shutdown(struct device *dev);
